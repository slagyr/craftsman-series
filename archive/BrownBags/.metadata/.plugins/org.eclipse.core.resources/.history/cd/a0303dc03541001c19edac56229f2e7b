class EmployeeReportVisitor
  def visitHourly(hourlyEmployee)
     @reportLine = "Hourly #{hourlyEmployee.getName} worked #{hourlyEmployee.getHours} hours."   
  end
  
  def visitSalaried(salariedEmployee)
    @reportLine = "Salaried #{salariedEmployee.getName} earns $#{salariedEmployee.getSalary}."
  end
  
  def getReportLine 
    @reportLine
  end
end